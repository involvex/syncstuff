{
  "name": "@syncstuff/app",
  "author": {
    "name": "Involvex"
  },
  "repository": {
    "url": "https://github.com/involvex/syncstuff.git"
  },
  "private": true,
  "version": "0.0.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test.unit",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "serve": "ionic serve",
    "start:signaling": "node signaling-server.cjs",
    "android": " ionic cap run android -l --external",
    "gradle:stop": "cd android && ./gradlew.bat --stop",
    "gradle:clean": "cd android && ./gradlew.bat clean",
    "electron:dev": "concurrently \"bun run start:signaling\" \"bun run dev\" \"bun run --cwd electron dev\"",
    "electron:build": "bun run build && bun run --filter @syncstuff/electron build",
    "electron:start": "bun run --cwd electron start"
  },
  "dependencies": {
    "@aparajita/capacitor-dark-mode": "^6.0.0",
    "@byteowls/capacitor-filesharer": "^7.0.0",
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.0.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@ionic/react": "^7.8.6",
    "@ionic/react-router": "^7.8.6",
    "@ionic/storage": "^4.0.0",
    "@syncstuff/ui": "workspace:*",
    "crypto-js": "^4.2.0",
    "ionicons": "^8.0.13",
    "megajs": "^1.3.9",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@syncstuff/network-types": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.drive": "^3.0.15",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/simple-peer": "^9.11.9",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.14.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "react-native-worklets": "^0.7.4",
    "terser": "^5.46.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^1.4.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  },
  "description": "An App to synchronize your files to all your devices."
}
