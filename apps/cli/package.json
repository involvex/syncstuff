{
  "name": "@involvex/syncstuff-cli",
  "version": "0.0.10",
  "type": "module",
  "homepage": "https://syncstuff-web.involvex.workers.dev/",
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  },
  "author": {
    "name": "involvex"
  },
  "bin": {
    "syncstuff": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build --target node --outfile dist/cli.js src/cli/index.ts",
    "lint": "eslint src ",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck",
    "prepublish": "bun run build"
  },
  "dependencies": {
    "@syncstuff/network-types": "workspace:*",
    "bonjour-service": "^1.1.1",
    "boxen": "8.0.1",
    "chalk": "5.6.2",
    "cli-progress": "^3.12.0",
    "clipboardy": "^5.3.1",
    "inquirer": "13.4.1",
    "ora": "9.3.0",
    "table": "6.9.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/css": "1.1.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@types/bun": "1.3.12",
    "@types/cli-progress": "^3.11.6",
    "@types/inquirer": "9.0.9",
    "@types/node": "25.6.0",
    "@types/uuid": "11.0.0",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript-eslint": "8.58.2"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
