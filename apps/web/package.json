    "eslint": "10.2.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.2",
    "typescript": "^6.0.3",
    "vite": "8.0.8",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "4.83.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc && remix vite:build && wrangler deploy --dry-run -c wrangler.toml",
    "deploy": "pnpm build && wrangler deploy -c wrangler.toml",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 remix vite:dev",
    "dev:mem": "cross-env NODE_OPTIONS=--max-old-space-size=8192 remix vite:dev",
    "wrangler:dev": "wrangler dev -c wrangler.toml",
    "wrangler:debug": "wrangler dev -c wrangler.toml --minify false -r --env-file .env --env development --log-level debug",
    "lint": "eslint . --ignore-pattern build --ignore-pattern .cache --ignore-pattern .wrangler",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "lint:fix": "eslint . --fix --ignore-pattern build  --ignore-pattern .cache --ignore-pattern .wrangler",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "sideEffects": false,
  "type": "module"
}
