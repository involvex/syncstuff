{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:ui"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "build:ui": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "build:shared": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "build:mobile": {
      "cache": false,
      "outputs": ["build/app/outputs/flutter-apk/**"]
    },
    "build:mobile:ios": {
      "cache": false,
      "outputs": ["build/ios/**"]
    },
    "build:desktop": {
      "cache": false,
      "outputs": ["build/windows/**"]
    },
    "build:cli_dart": {
      "cache": false,
      "outputs": ["syncstuff", "syncstuff.exe"]
    },
    "dev": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development.local",
        ".env.local",
        ".env.development",
        ".env"
      ],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "inputs": ["src/**", "*.config.*", "eslint.config.*"]
    },
    "lint:fix": {
      "inputs": ["src/**", "*.config.*", "eslint.config.*"],
      "cache": false
    },
    "format": {
      "inputs": ["src/**", "*.config.*", "*.json", "*.md"],
      "cache": false
    },
    "format:check": {
      "inputs": ["src/**", "*.config.*", "*.json", "*.md"],
      "cache": false
    },
    "typecheck": {
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "test:mobile": {
      "cache": false
    },
    "test:desktop": {
      "cache": false
    },
    "test:cli_dart": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "check": {
      "cache": false,
      "dependsOn": ["lint:fix", "format", "typecheck"]
    }
  }
}
