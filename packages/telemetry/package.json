{
  "name": "@syncstuff/telemetry",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy -c wrangler.toml",
    "dev": "wrangler dev -c wrangler.toml --env-file .env",
    "dev:local": "wrangler dev -c wrangler.toml -l --env-file .env",
    "start": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@microlabs/otel-cf-workers": "^1.0.0-rc.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/otlp-exporter-base": "^0.215.0",
    "@opentelemetry/otlp-transformer": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "deepmerge": "^4.3.1",
    "ts-checked-fsm": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260703.1",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "globals": "17.7.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  }
}
