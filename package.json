{
  "name": "syncstuff-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.12",
  "type": "module",
  "workspaces": ["apps/web", "apps/cli_dart", "packages/*"],
  "scripts": {
    "build": "turbo run build && bun run build:desktop",
    "build:web": "bun run build:ui && bun run --filter @syncstuff/web build",
    "build:ui": "bun run --filter @syncstuff/ui build",
    "build:shared": "bun run --filter @syncstuff/shared build",
    "build:mobile": "cd apps/mobile && flutter build apk",
    "build:mobile:ios": "cd apps/mobile && flutter build ios",
    "build:desktop": "cmd /c build_desktop.bat",
    "build:desktop:raw": "cd apps/desktop && flutter build windows",
    "build:cli_dart": "cd apps/cli_dart && dart compile exe bin/main.dart -o syncstuff",
    "build:telemetry": "bun run --filter @syncstuff/telemetry typecheck",
    "dev": "turbo run dev",
    "dev:web": "bun run build:ui && bun run --filter @syncstuff/web dev",
    "dev:api": "bun run --filter @syncstuff/api dev",
    "dev:mobile": "cd apps/mobile && flutter run",
    "dev:desktop": "cmd /c dev_desktop.bat",
    "dev:desktop:raw": "cd apps/desktop && flutter run -d windows",
    "dev:cli_dart": "cd apps/cli_dart && dart run bin/main.dart",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:mobile": "cd apps/mobile && flutter test",
    "test:desktop": "cd apps/desktop && flutter test",
    "test:cli_dart": "cd apps/cli_dart && dart test",
    "db:create": "bun run --filter @syncstuff/database create",
    "db:migrate": "bun run --filter @syncstuff/database migrate",
    "deploy:web": "bun run --filter @syncstuff/web deploy",
    "deploy:api": "bun run --filter @syncstuff/api deploy",
    "deploy:telemetry": "bun run --filter @syncstuff/telemetry deploy",
    "check-secrets": "node scripts/check-secrets.cjs",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write --unsafe --log-level error --log-kind pretty",
    "biome:format:fix": "biome format . --fix",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint . --fix",
    "biome:format": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@eslint/js": "10.0.1",
    "@involvex/bun-scanner": "2.0.1",
    "@still-forest/biomejs-config": "2.2.0",
    "@types/bun": "1.3.13",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "esbuild": "^0.25.0",
    "undici": "^7.18.2",
    "diff": "^8.0.3",
    "tmp": "^0.2.4",
    "@remix-run/router": "^1.23.2",
    "estree-util-value-to-estree": "^3.5.0",
    "@remix-run/react>react-router": "^6.30.2",
    "@remix-run/react>react-router-dom": "^6.30.2",
    "ip": "2.0.1",
    "elliptic": "^6.6.1"
  },
  "trustedDependencies": ["core-js", "esbuild", "protobufjs", "sharp", "unrs-resolver", "workerd"],
  "dependencies": {
    "eslint": "10.2.1"
  }
}
