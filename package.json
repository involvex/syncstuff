{
  "name": "syncstuff-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.12",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "apps/mobileapp/electron"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "android": "bun run --filter @syncstuff/app android",
    "web": "bun run build:ui && bun run --filter @syncstuff/web dev",
    "api": "bun run --filter @syncstuff/api dev",
    "mobile": "bun run --filter @syncstuff/app android",
    "debug:android": "node scripts/debug-android.cjs",
    "debug:android:verbose": "node scripts/debug-android.cjs --verbose",
    "debug:android:clear": "node scripts/debug-android.cjs --clear",
    "debug:web": "node scripts/debug-web.cjs",
    "debug:web:verbose": "node scripts/debug-web.cjs --verbose",
    "debug:electron": "node scripts/debug-electron.cjs",
    "debug:electron:verbose": "node scripts/debug-electron.cjs --verbose",
    "debug:app": "bun run --filter @syncstuff/app debug:android",
    "debug:cli": "bun run --filter @involvex/syncstuff-cli dev --verbose --debug",
    "logcat": "adb logcat | grep -i syncstuff",
    "logcat:clear": "adb logcat -c",
    "doctor": "node scripts/doctor.cjs",
    "check-secrets": "node scripts/check-secrets.cjs",
    "build:ui": "bun run --filter @syncstuff/ui build",
    "build:shared": "bun run --filter @syncstuff/shared build",
    "build:app": "bun run --filter @syncstuff/app build",
    "build:web": "bun run build:ui && bun run --filter @syncstuff/web build",
    "build:telemetry": "bun run --filter @syncstuff/telemetry typecheck",
    "db:create": "bun run --filter @syncstuff/database create",
    "db:migrate": "bun run --filter @syncstuff/database migrate",
    "deploy:api": "bun run --filter @syncstuff/api deploy",
    "deploy:web": "bun run --filter @syncstuff/web deploy",
    "deploy:db": "bun run --filter @syncstuff/db deploy",
    "deploy:telemetry": "bun run --filter @syncstuff/telemetry deploy",
    "gradle:stop": "bun run --filter @syncstuff/app gradle:stop",
    "gradle:clean": "bun run --filter @syncstuff/app gradle:clean",
    "app:version:patch": "node scripts/bump-app-version.cjs --patch",
    "app:version:minor": "node scripts/bump-app-version.cjs --minor",
    "app:version:major": "node scripts/bump-app-version.cjs --major",
    "check": "turbo run check",
    "test:app": "bun run --filter @syncstuff/app test",
    "electron:dev": "bun run --filter @syncstuff/app electron:dev",
    "electron:build": "bun run --filter @syncstuff/app electron:build",
    "electron:start": "bun run --filter @syncstuff/app electron:start",
    "build:cli": "bun run --filter @involvex/syncstuff-cli build",
    "dev:cli": "bun run --filter @involvex/syncstuff-cli dev",
    "publish:cli": "bun run --filter @involvex/syncstuff-cli build && npm publish --access public",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write --unsafe --log-level error --log-kind pretty",
    "biome:format:fix": "biome format . --fix",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint . --fix",
    "biome:format": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@eslint/js": "10.0.1",
    "@involvex/bun-scanner": "2.0.1",
    "@still-forest/biomejs-config": "2.2.0",
    "@tamagui/config": "2.0.0-rc.41",
    "@tamagui/core": "2.0.0-rc.41",
    "@tamagui/themes": "2.0.0-rc.41",
    "@types/bun": "1.3.12",
    "globals": "17.5.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tamagui": "2.0.0-rc.41",
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "esbuild": "^0.25.0",
    "undici": "^7.18.2",
    "diff": "^8.0.3",
    "tmp": "^0.2.4",
    "@remix-run/router": "^1.23.2",
    "estree-util-value-to-estree": "^3.5.0",
    "@remix-run/react>react-router": "^6.30.2",
    "@remix-run/react>react-router-dom": "^6.30.2",
    "ip": "2.0.1",
    "elliptic": "^6.6.1"
  },
  "trustedDependencies": [
    "@syncstuff/electron",
    "core-js",
    "protobufjs",
    "unrs-resolver"
  ],
  "dependencies": {
    "@tamagui/lucide-icons-2": "2.0.0-rc.41"
  }
}
